{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard when using Workers Builds.
  "name": "portfolio",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  // Reuse the existing proxied DNS record. More specific /village routes belong to the game Worker.
  "routes": [
    { "pattern": "portfolio.moudka.com/*", "zone_name": "moudka.com" }
  ],
  // Pure static site: no Worker script, Cloudflare serves the exported files directly.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
