{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check:out": "node scripts/check-out.mjs",
    "preview": "wrangler dev --port 8787",
    "test:e2e": "playwright test",
    "screens": "node scripts/screens.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run check:out && npm run test:e2e",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-stringify": "10.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "0.0.1",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "wrangler": "4.154.0"
  }
